<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="aruco_marker_0">
    <static>true</static> <!-- Set to true so it stays fixed in space -->
    <link name="link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.15 0.15 0.001</size> <!-- Width, Height, Thickness in meters -->
          </box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/aruco_marker_0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.15 0.15 0.001</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>