<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="rover_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Sim System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    
    <!-- Sensor Engine Plugin (Required for LiDAR) -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>38.411</latitude_deg>
      <longitude_deg>-110.786</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Inline Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================= URC 2027 Autonomy Mission props =================
         Positions are east/north metres from the world origin and are
         mirrored as lat/lon in config/mission_2027.yaml - keep both in sync.
         z is 0 for flat ground: on terrain, set z to the ground height at
         that spot (the post pole extends 0.3 m below its origin). -->

    <!-- Route-finding targets (rule 1.e.xii): three-sided ArUco posts -->
    <include>
      <uri>model://aruco_post_0</uri>
      <name>aruco_post_0</name>
      <pose>12 5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_post_1</uri>
      <name>aruco_post_1</name>
      <pose>30 -14 0 0 0 0.5</pose>
    </include>

    <!-- Fetch! (rule 1.e.viii): rock pick hammer lying on the ground -->
    <include>
      <uri>model://rock_hammer</uri>
      <name>rock_hammer</name>
      <pose>5 -3 0.02 0 0 0.8</pose>
    </include>

    <!-- Inline Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
