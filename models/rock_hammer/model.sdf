<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Stand-in for the URC 2027 "Fetch!" rock pick hammer (rule 1.e.viii).
       Simple shapes at roughly the right size and mass, for grasp testing.
       Model origin is the middle of the handle; the hammer lies along x. -->
  <model name="rock_hammer">
    <link name="link">
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.0003</ixx><iyy>0.006</iyy><izz>0.006</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="handle">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.30</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.2 0.7 1</ambient>
          <diffuse>0.05 0.2 0.7 1</diffuse>
        </material>
      </visual>
      <visual name="head">
        <pose>0.15 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.025 0.18 0.025</size></box>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.55 0.55 0.58 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <collision name="handle">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.30</length></cylinder>
        </geometry>
      </collision>
      <collision name="head">
        <pose>0.15 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.025 0.18 0.025</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
